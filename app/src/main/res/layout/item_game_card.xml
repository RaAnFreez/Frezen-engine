<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp">

    <!-- Game image + warning overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/card_bg">

        <!-- Game screenshot/icon -->
        <ImageView
            android:id="@+id/iv_game_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>

        <!-- Warning icon overlay (muncul kalau tidak ter-install) -->
        <FrameLayout
            android:id="@+id/iv_warning"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/warning_bg"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⚠"
                android:textSize="20sp"
                android:textColor="#FCD34D"/>
        </FrameLayout>

    </FrameLayout>

    <!-- Game name -->
    <TextView
        android:id="@+id/tv_game_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#EFEFF1"
        android:textSize="11sp"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"/>

</LinearLayout>
